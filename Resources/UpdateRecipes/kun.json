{
  "id": "com.xingyuzhong.deepseekgui",
  "name": "Kun",
  "recipePrompt": "这个规则用于检测 Kun。应用包内 app-update.yml 指向 kun-agent.com 官方更新源；latest-mac.yml 提供最新版本以及 x64/arm64 的 ZIP 和 DMG，下载时优先 arm64 DMG。",
  "match": {
    "bundleIdentifier": "com.xingyuzhong.deepseekgui",
    "appName": "Kun",
    "officialHost": "kun-agent.com"
  },
  "checks": [
    {
      "url": "https://www.kun-agent.com/api/r2/deepseek-gui/channels/stable/latest/latest-mac.yml",
      "extract": {
        "type": "regex",
        "pattern": "(?m)^version:\\s*([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\\s*$",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://www.kun-agent.com/",
  "download": {
    "url": null,
    "sourceURL": "https://www.kun-agent.com/api/r2/deepseek-gui/channels/stable/latest/latest-mac.yml",
    "pattern": "url:\\s*(Kun-[^\\r\\n]+\\.(?:dmg|zip))",
    "urlGroup": 1
  }
}
