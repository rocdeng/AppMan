{
  "id": "com.panic.Transmit",
  "name": "Transmit",
  "recipePrompt": "这个规则用于检测 Panic Transmit 5。官方 Sparkle 接口必须带 appName=Transmit 5 和 appVersion=5，否则会返回 400；从 enclosure 的 sparkle:shortVersionString 读取版本并获取官方 ZIP。",
  "match": {
    "bundleIdentifier": "com.panic.Transmit",
    "appName": "Transmit",
    "officialHost": "panic.com"
  },
  "checks": [
    {
      "url": "https://www.panic.com/updates/update.php?appName=Transmit%205&appVersion=5",
      "extract": {
        "type": "regex",
        "pattern": "sparkle:shortVersionString=\"([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://www.panic.com/transmit/",
  "download": {
    "url": null,
    "sourceURL": "https://www.panic.com/updates/update.php?appName=Transmit%205&appVersion=5",
    "pattern": "url=\"([^\"]*Transmit(?:%20|\\s)+[0-9]+(?:\\.[0-9A-Za-z]+){1,5}\\.zip)\"",
    "urlGroup": 1
  }
}
