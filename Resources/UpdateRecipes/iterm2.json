{
  "id": "com.googlecode.iterm2",
  "name": "iTerm2",
  "recipePrompt": "这个规则用于检测 iTerm2 现代 macOS 稳定版。必须使用 App 内置的 https://iterm2.com/appcasts/final_modern.xml；final.xml 只保留到 3.3.12，不能用于当前版本。enclosure 上的 sparkle:version 是稳定版版本号。",
  "match": {
    "bundleIdentifier": "com.googlecode.iterm2",
    "appName": "iTerm2",
    "officialHost": "iterm2.com"
  },
  "checks": [
    {
      "url": "https://iterm2.com/appcasts/final_modern.xml",
      "extract": {
        "type": "regex",
        "pattern": "sparkle:version=\"([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://iterm2.com/downloads.html",
  "download": {
    "url": null,
    "sourceURL": "https://iterm2.com/appcasts/final_modern.xml",
    "pattern": "url=\"([^\"]*iTerm2-[^\"]+\\.zip)\"",
    "urlGroup": 1
  }
}
