{
  "id": "com.googlecode.iterm2",
  "name": "iTerm2",
  "recipePrompt": "这个规则用于检测 iTerm2 稳定版。官方 Sparkle appcast 是 https://iterm2.com/appcasts/final.xml，enclosure 上的 sparkle:version 是稳定版版本号。不要从下载页面的文件日期或 zip 后缀猜版本。",
  "match": {
    "bundleIdentifier": "com.googlecode.iterm2",
    "appName": "iTerm2",
    "officialHost": "iterm2.com"
  },
  "checks": [
    {
      "url": "https://iterm2.com/appcasts/final.xml",
      "extract": {
        "type": "regex",
        "pattern": "sparkle:version=\"([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://iterm2.com/downloads.html"
}
