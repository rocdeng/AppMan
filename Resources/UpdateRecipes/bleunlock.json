{
  "id": "jp.sone.BLEUnlock",
  "name": "BLEUnlock",
  "recipePrompt": "这个规则用于检测 BLEUnlock。官方项目在 GitHub ts1/BLEUnlock，releases/latest 的 tag_name 是可比较版本号。",
  "match": {
    "bundleIdentifier": "jp.sone.BLEUnlock",
    "appName": "BLEUnlock",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/ts1/BLEUnlock/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://github.com/ts1/BLEUnlock/releases/latest"
}
