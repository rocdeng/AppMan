{
  "id": "pro.betterdisplay.BetterDisplay",
  "name": "BetterDisplay",
  "recipePrompt": "这个规则用于检测 BetterDisplay 稳定版。BetterDisplay 的 Sparkle appcast 可能包含 internal/pre-release channel，容易误取 5.0.0 internal；因此使用 GitHub latest release 的 tag_name。",
  "match": {
    "bundleIdentifier": "pro.betterdisplay.BetterDisplay",
    "appName": "BetterDisplay",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/waydabber/BetterDisplay/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://github.com/waydabber/BetterDisplay/releases/latest",
  "download": {
    "url": null,
    "sourceURL": "https://api.github.com/repos/waydabber/BetterDisplay/releases/latest",
    "pattern": "\"browser_download_url\"\\s*:\\s*\"([^\"]*\\.dmg)\"",
    "urlGroup": 1
  }
}
