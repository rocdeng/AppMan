{
  "id": "com.todesktop.241012ess7yxs0e",
  "name": "Comfy Desktop",
  "recipePrompt": "这个规则用于检测 Comfy Desktop。应用包内 app-update.yml 指向 ToDesktop 官方更新源 https://download.todesktop.com/241130tqe9q3y；latest-mac.yml 同时提供 version 和 arm64 安装包。",
  "match": {
    "bundleIdentifier": "com.todesktop.241012ess7yxs0e",
    "appName": null,
    "officialHost": "comfy.org"
  },
  "checks": [
    {
      "url": "https://download.todesktop.com/241130tqe9q3y/latest-mac.yml",
      "extract": {
        "type": "regex",
        "pattern": "(?m)^version:\\s*([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\\s*$",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://www.comfy.org/download",
  "download": {
    "url": null,
    "sourceURL": "https://download.todesktop.com/241130tqe9q3y/latest-mac.yml",
    "pattern": "url:\\s*(.+\\.(?:dmg|zip))",
    "urlGroup": 1
  }
}
