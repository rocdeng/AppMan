{
  "id": "com.microsoft.VSCode",
  "name": "Code",
  "recipePrompt": "这个规则用于检测 Visual Studio Code。官方版本发布在 GitHub microsoft/vscode releases，GitHub API 的 tag_name 形如 1.127.0。不要从 code.visualstudio.com/download 页面脚本资源名抽取版本。",
  "match": {
    "bundleIdentifier": "com.microsoft.VSCode",
    "appName": "Code",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/microsoft/vscode/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://code.visualstudio.com/download",
  "download": {
    "url": "https://update.code.visualstudio.com/latest/darwin-arm64/stable",
    "sourceURL": null,
    "pattern": null,
    "urlGroup": null
  }
}
