{
  "id": "com.mitchellh.ghostty",
  "name": "Ghostty",
  "recipePrompt": "这个规则用于检测 Ghostty 官网下载页。新版页面会在 Version 和版本号之间插入 HTML 注释，因此直接从 release.files.ghostty.org/<version>/Ghostty.dmg 的稳定路径提取版本，并使用同一链接下载通用 macOS DMG。",
  "match": {
    "bundleIdentifier": "com.mitchellh.ghostty",
    "appName": "Ghostty",
    "officialHost": "ghostty.org"
  },
  "checks": [
    {
      "url": "https://ghostty.org/download",
      "extract": {
        "type": "regex",
        "pattern": "release\\.files\\.ghostty\\.org/([0-9]+(?:\\.[0-9A-Za-z]+){1,5})/Ghostty\\.dmg",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://ghostty.org/download",
  "download": {
    "url": null,
    "sourceURL": "https://ghostty.org/download",
    "pattern": "href=\"([^\"]*Ghostty\\.dmg)\"",
    "urlGroup": 1
  }
}
