{
  "id": "io.github.gyulyvgc.sniffnet",
  "name": "Sniffnet",
  "recipePrompt": "这个规则用于检测 Sniffnet。官方版本发布在 GitHub gyulyvgc/sniffnet releases，GitHub API 的 tag_name 形如 v1.5.0。不要从 Linux .deb 文件名里的架构数字抽取版本。",
  "match": {
    "bundleIdentifier": "io.github.gyulyvgc.sniffnet",
    "appName": "Sniffnet",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/gyulyvgc/sniffnet/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://github.com/gyulyvgc/sniffnet/releases"
}
