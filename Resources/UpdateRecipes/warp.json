{
  "id": "dev.warp.Warp-Stable",
  "name": "Warp",
  "recipePrompt": "这个规则用于识别 Warp Stable。版本来自 warpdotdev/warp GitHub latest release 的 stable tag_name，例如 v0.2026.06.03.09.49.stable_00；GitHub release 当前不带 dmg asset，所以只能检测版本，下载/安装仍跳官网。",
  "match": {
    "bundleIdentifier": "dev.warp.Warp-Stable",
    "appName": "Warp",
    "officialHost": "warp.dev"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/warpdotdev/warp/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\\.stable_[^\"]*\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://www.warp.dev/",
  "download": null
}
