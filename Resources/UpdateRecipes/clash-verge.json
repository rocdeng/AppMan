{
  "id": "io.github.clash-verge-rev.clash-verge-rev",
  "name": "Clash Verge",
  "recipePrompt": "这个规则用于检测 Clash Verge Rev。官方版本发布在 GitHub clash-verge-rev/clash-verge-rev releases，GitHub API 的 tag_name 形如 v2.5.1，去掉 v 即为版本。",
  "match": {
    "bundleIdentifier": "io.github.clash-verge-rev.clash-verge-rev",
    "appName": "Clash Verge",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/clash-verge-rev/clash-verge-rev/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://github.com/clash-verge-rev/clash-verge-rev/releases"
}
