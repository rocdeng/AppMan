{
  "id": "now.typeless.desktop",
  "name": "Typeless",
  "recipePrompt": "这个规则用于检测 Typeless desktop。macOS Apple Silicon 的 Electron updater feed 是 typeless-static.com/desktop-release/arm64-mac.yml，version 字段是当前版本，files.url 中的 arm64 dmg 是安装包。",
  "match": {
    "bundleIdentifier": "now.typeless.desktop",
    "appName": "Typeless",
    "officialHost": "typeless-static.com"
  },
  "checks": [
    {
      "url": "https://typeless-static.com/desktop-release/arm64-mac.yml",
      "extract": {
        "type": "regex",
        "pattern": "(?m)^version:\\s*([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\\s*$",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://www.typeless.com/",
  "download": {
    "url": null,
    "sourceURL": "https://typeless-static.com/desktop-release/arm64-mac.yml",
    "pattern": "(?m)^\\s*-\\s+url:\\s*(Typeless-[^\\n]+-arm64\\.dmg)\\s*$",
    "urlGroup": 1
  }
}
