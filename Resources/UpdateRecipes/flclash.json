{
  "id": "com.follow.clash",
  "name": "FlClash",
  "recipePrompt": "这个规则用于检测 FlClash。官方发布在 GitHub chen08209/FlClash releases，GitHub API 的 tag_name 是版本号。Apple Silicon 机器必须优先下载 macos-arm64 dmg，不要选 macos-amd64。",
  "match": {
    "bundleIdentifier": "com.follow.clash",
    "appName": "FlClash",
    "officialHost": "github.com"
  },
  "checks": [
    {
      "url": "https://api.github.com/repos/chen08209/FlClash/releases/latest",
      "extract": {
        "type": "regex",
        "pattern": "\"tag_name\"\\s*:\\s*\"v?([0-9]+(?:\\.[0-9A-Za-z]+){1,5})\"",
        "versionGroup": 1
      }
    }
  ],
  "updatePageURL": "https://github.com/chen08209/FlClash/releases/latest",
  "download": {
    "url": null,
    "sourceURL": "https://api.github.com/repos/chen08209/FlClash/releases/latest",
    "pattern": "\"browser_download_url\"\\s*:\\s*\"([^\"]*(?:macos|darwin)[-_]?arm64[^\"]*\\.(?:dmg|zip))\"",
    "urlGroup": 1
  }
}
